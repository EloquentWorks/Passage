{
    "name": "eloquent-works/passage",
    "description": "A feature-rich onboarding, checklist, journey, and progression engine for Laravel.",
    "keywords": [
        "laravel",
        "onboarding",
        "workflow",
        "journey",
        "checklist",
        "progress"
    ],
    "homepage": "https://github.com/EloquentWorks/Passage",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Eloquent Works"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "EloquentWorks\\Passage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EloquentWorks\\Passage\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EloquentWorks\\Passage\\PassageServiceProvider"
            ],
            "aliases": {
                "Passage": "EloquentWorks\\Passage\\Facades\\Passage"
            }
        }
    },
    "scripts": {
        "format": "pint --test",
        "format:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "quality": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
